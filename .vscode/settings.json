{
  "cSpell.words": [
    "Cupertino",
    "Fluxy",
    "riverpod",
    "sqflite"
  ],
  "dart.flutterSdkPath": ".fvm/versions/3.41.5",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "pubspec.yaml": "pubspec.lock,analysis_options.yaml,.packages,.flutter-plugins,.flutter-plugins-dependencies,flutter_launcher_icons*.yaml,flutter_native_splash*.yaml,distribute_options.yaml",
    "README.md": "LICENSE,CODE_OF_CONDUCT.md,CONTRIBUTING.md,SECURITY.md,CONTRIBUTION.md,CHANGELOG.md,PRIVACY_POLICY.md",
    "*.dart": "${capture}.g.dart,${capture}.freezed.dart"
  },
    "workbench.colorCustomizations": {
    // "activityBar.background": "#3c3f41",
    // "titleBar.activeBackground": "#3c3f41",
    "titleBar.activeForeground": "#bbbbbb",
    "editor.background": "#2b2b2b"
  }
}